        "beats": [
          {
            "id": "8e7ad4e7-572e-41a5-a761-e31fbfc895ca",
            "characterId": "ch-max",
            "text": "Chapter One: The Super Sniffing Power of Dogs!",
            "action": "read",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "0471b9fc-93a4-4b21-a818-a567704c6391",
            "characterId": "ch-max",
            "text": "See, Rex? I am studying… for US!",
            "action": "write",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "5ed4a018-4451-436c-8883-211da69d2d25",
            "characterId": "ch-rex",
            "text": "Woof woof!",
            "action": "wag",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "4d04e019-fa17-4d7f-a120-61809e3494cf",
            "characterId": "ch-mom",
            "text": "Well… THAT is new!",
            "action": "laugh",
            "emotion": "happy",
            "targetId": "cast-max"
          },
          {
            "id": "5a0afd38-5099-43f2-8328-070ddd72fab2",
            "characterId": "ch-mom",
            "text": "I am proud of you, Max.",
            "action": "clap",
            "emotion": "happy",
            "targetId": "cast-max"
          },
          {
            "id": "7a63af6f-f88b-45cb-a069-6b0bfe567966",
            "characterId": "ch-max",
            "text": "Thank you, Mom! I love you!",
            "action": "hug",
            "emotion": "happy",
            "targetId": "cast-mom"
          },
          {
            "id": "e2b0a4e1-6187-49ab-899d-b1c34bd811a9",
            "characterId": null,
            "text": "Max still loves animals more than anything. But now he has a dream — and a plan.",
            "action": "none",
            "emotion": "inherit",
            "targetId": null
          },
          {
            "id": "c752ad84-7662-4aef-90ff-7d55120b2db9",
            "characterId": "ch-max",
            "text": "Homework now… vet school later!",
            "action": "cheer",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "0f5d1bf9-1173-4d21-b66a-7626ca65d5d8",
            "characterId": "ch-max",
            "text": "Come on, Rex — let's go tell everyone!",
            "action": "exit",
            "emotion": "happy",
            "targetId": null
          }
        ]
      },
      {
        "id": "f205b379-e8fe-49ac-8780-01c1ed5f1222",
        "kind": "title",
        "backgroundId": "sunset-hill",
        "camera": "zoom",
        "transition": "fade",
        "title": "The End",
        "subtitle": "Find what makes you curious — then study like crazy.",
