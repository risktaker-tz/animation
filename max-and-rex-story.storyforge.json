        "beats": [
          {
            "id": "f5122ce2-c652-4d7c-bc0f-85ad9696fa33",
            "characterId": null,
            "text": "This is the story of a boy who did not want to study… and the animals who changed his mind.",
            "action": "none",
            "emotion": "inherit",
            "targetId": null
          }
        ]
      },
      {
        "id": "b1cabed2-14fc-4c47-9ad0-a7513106aaba",
