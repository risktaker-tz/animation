            "enter": "runLeft"
          }
        ],
        "beats": [
          {
            "id": "7a370e75-d89c-4ee5-bfb6-d7572eed96a9",
            "characterId": "ch-max",
            "text": "While Mom is busy… Operation Animal Time begins!",
            "action": "sneak",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "7dc38310-fa33-4743-866f-c67a4d7386db",
            "characterId": "ch-whiskers",
            "text": "Meow!",
            "action": "meow",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "940564fb-102d-4358-a329-75f231bfd83d",
            "characterId": "ch-max",
            "text": "Whiskers! And look — Rex is ready to play!",
            "action": "cheer",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "7fe4e769-cf23-472e-9c0c-a0c8470e079d",
            "characterId": "ch-rex",
            "text": "Woof woof!",
            "action": "bark",
            "emotion": "happy",
            "targetId": null
          }
        ]
      },
      {
        "id": "324910f7-43b4-41ae-aa88-5a10de279827",
        "kind": "scene",
        "backgroundId": "park",
        "camera": "wide",
        "transition": "fade",
        "title": "",
        "subtitle": "",
        "cast": [
          {
            "id": "cast-max",
            "characterId": "ch-max",
            "position": "left",
            "emotion": "happy",
            "enter": "none"
          },
          {
            "id": "cast-rex",
            "characterId": "ch-rex",
            "position": "right",
            "emotion": "happy",
            "enter": "none"
          }
        ],
        "beats": [
          {
            "id": "47570863-9345-44e2-929a-90a29a3eb4c9",
            "characterId": null,
            "text": "At the park, Max and Rex played their favorite game.",
            "action": "none",
            "emotion": "inherit",
            "targetId": null
          },
          {
            "id": "00688f00-f351-4ff6-8ef5-fe5562329a19",
            "characterId": "ch-max",
            "text": "Go get it, Rex!",
            "action": "fetch",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "a0303ae9-9b62-46fb-88c6-91470980641f",
            "characterId": "ch-rex",
            "text": "Woof!",
            "action": "run",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "63f7345e-71ab-410b-8c5c-4cd4cdf8589b",
            "characterId": "ch-max",
            "text": "Good boy! You found it so fast. You are the smartest dog ever!",
            "action": "pet",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "959cfe3f-8c77-4e8b-9512-f93d0c03ab50",
            "characterId": "ch-rex",
            "text": "Woof woof!",
            "action": "wag",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "375400da-a302-4dbd-8e3a-371cf181998a",
            "characterId": "ch-max",
            "text": "Haha! You always make me laugh, boy.",
            "action": "laugh",
            "emotion": "happy",
            "targetId": "cast-rex"
          },
          {
            "id": "f65a8f1b-30cc-4b39-8bd9-3b89625feb27",
            "characterId": "ch-max",
            "text": "Hmm… how DO you find everything so quickly, boy?",
            "action": "think",
            "emotion": "neutral",
            "targetId": "cast-rex"
          }
        ]
      },
      {
        "id": "5df64fc8-384b-43d0-8beb-c30f36d37e6b",
        "kind": "scene",
        "backgroundId": "park",
        "camera": "wide",
        "transition": "fade",
        "title": "",
        "subtitle": "",
        "cast": [
          {
            "id": "cast-max",
            "characterId": "ch-max",
            "position": "left",
            "emotion": "happy",
            "enter": "none"
          },
          {
            "id": "cast-rex",
            "characterId": "ch-rex",
            "position": "center",
            "emotion": "happy",
            "enter": "none"
          },
          {
            "id": "cast-dad",
            "characterId": "ch-dad",
            "position": "right",
            "emotion": "neutral",
            "enter": "walkRight"
          }
        ],
        "beats": [
          {
            "id": "4c382bac-7027-456a-8da8-8e8c080c627d",
            "characterId": "ch-dad",
            "text": "Max… is not homework time right now?",
            "action": "point",
            "emotion": "neutral",
            "targetId": "cast-max"
          },
          {
            "id": "c559e414-94e7-4420-a42d-454a0746de7c",
            "characterId": "ch-max",
            "text": "I… I was just… Rex needed exercise!",
            "action": "gasp",
            "emotion": "scared",
            "targetId": "cast-dad"
          },
          {
            "id": "9a939399-8a75-4c68-8309-99cb8885cb91",
            "characterId": "ch-dad",
            "text": "Interesting. You taught Rex to fetch all by yourself?",
            "action": "think",
            "emotion": "neutral",
            "targetId": "cast-max"
          },
          {
            "id": "3a925b3d-5ab2-41d9-b17c-01fb938f86e1",
            "characterId": "ch-max",
            "text": "Well… yeah. Watch! Rex, sit!",
            "action": "point",
            "emotion": "neutral",
            "targetId": "cast-rex"
          },
          {
            "id": "d25d6aee-e694-4624-a2cf-8eacb00a8a9b",
            "characterId": "ch-rex",
            "text": "Woof!",
            "action": "sit",
            "emotion": "happy",
            "targetId": null
          },
          {
            "id": "f18cdc6f-fb01-47fc-bc89-bfe12e7c9443",
            "characterId": "ch-dad",
            "text": "That, kiddo, is animal science. Vets and zookeepers study every single day — to help animals.",
            "action": "nod",
            "emotion": "happy",
            "targetId": "cast-max"
          },
          {
            "id": "ae866815-64ee-4d5b-bbb3-cc4348fee8db",
            "characterId": "ch-max",
            "text": "WAIT. Studying helps me help ANIMALS?! Then give me that homework!",
            "action": "cheer",
            "emotion": "surprised",
            "targetId": "cast-dad"
          },
          {
            "id": "c4901ad5-b4bf-427b-b65f-30d4d00d5ec0",
            "characterId": "ch-dad",
            "text": "Ha! That is the spirit, champ.",
            "action": "laugh",
            "emotion": "happy",
            "targetId": "cast-max"
          },
          {
            "id": "5f69606c-c3a2-491b-8498-0fe335fa96fd",
            "characterId": "ch-max",
            "text": "High five, Dad!",
            "action": "highfive",
            "emotion": "happy",
            "targetId": "cast-dad"
          }
        ]
      },
      {
        "id": "27428ec8-df15-4b82-a5f6-415752f2e6a5",
        "kind": "scene",
