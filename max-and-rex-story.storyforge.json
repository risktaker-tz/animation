            "enter": "walkRight"
          }
        ],
        "beats": [
          {
            "id": "235a842c-7b72-4aef-8b1d-4d8c86593c18",
            "characterId": null,
            "text": "Saturday morning. Homework time.",
            "action": "none",
            "emotion": "inherit",
            "targetId": null
          },
          {
            "id": "32ce6629-ef94-46a8-8073-dab20e43dc3a",
            "characterId": "ch-max",
            "text": "Addition. Spelling. AGAIN. I do NOT want to study!",
            "action": "write",
            "emotion": "angry",
            "targetId": null
          },
          {
            "id": "c2411883-b3fa-4476-ac8b-7839e6d2e40c",
            "characterId": "ch-max",
            "text": "Books are so boring… animals are awesome.",
            "action": "sulk",
            "emotion": "sad",
            "targetId": null
          },
          {
            "id": "6611a900-c6aa-4650-bf9d-140b57415ddb",
            "characterId": "ch-mom",
            "text": "Max! Homework first, then play.",
            "action": "point",
            "emotion": "neutral",
            "targetId": "cast-max"
          },
          {
            "id": "c1c340f5-183c-4bb1-bc34-6ac1c3a682ca",
            "characterId": "ch-max",
            "text": "But Mom… studying is for grown-ups!",
            "action": "shrug",
            "emotion": "sad",
            "targetId": "cast-mom"
          },
          {
            "id": "40d82f88-5376-43a3-9095-f4ed348ee2db",
            "characterId": "ch-mom",
            "text": "Finish page ten. I will check in one hour.",
            "action": "nod",
            "emotion": "neutral",
            "targetId": "cast-max"
          },
          {
            "id": "511bd244-84d1-4ea8-b6b8-aecb29a74501",
            "characterId": "ch-mom",
            "text": "And no sneaking off, young man.",
            "action": "point",
            "emotion": "happy",
            "targetId": "cast-max"
          }
        ]
      },
      {
        "id": "72099da4-09bf-4b32-87b0-2da9f8cd7bda",
        "kind": "scene",
        "backgroundId": "living-room",
        "camera": "wide",
        "transition": "slide",
        "title": "",
        "subtitle": "",
        "cast": [
          {
            "id": "cast-max",
